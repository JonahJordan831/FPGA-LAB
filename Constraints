## Clock (Basys 3 100MHz)
set_property PACKAGE_PIN W5 [get_ports clk]					
set_property IOSTANDARD LVCMOS33 [get_ports clk]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0.0 5.0} [get_ports clk]

