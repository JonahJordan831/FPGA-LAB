`timescale 1ns / 1ps

module vertical_counter (
    input clk_25MHz,
    input v_enable,
    output reg [9:0] V_Count = 0  // 0-524
);
    
    always @(posedge clk_25MHz) begin
        if (v_enable) begin
            if (V_Count == 524) begin
                V_Count <= 0;
            end else begin
                V_Count <= V_Count + 1;
            end
        end
    end
endmodule
