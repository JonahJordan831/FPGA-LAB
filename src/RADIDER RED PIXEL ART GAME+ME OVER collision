`timescale 1ns / 1ps
module top (
    input clk,              // 100MHz Basys 3
    input BTNU,             // Up button
    input BTNL,             // Down button (physically down, labeled left)
    input BTNR,             // Left button (physically left, labeled right)
    input BTNC,             // Right button (physically right, labeled center)
    input BTND,             // Center button - reset (physically center, labeled down)
    output reg Hsync,
    output reg Vsync,
    output reg [3:0] Red,
    output reg [3:0] Green,
    output reg [3:0] Blue
);
    // Clock divider
    reg [1:0] clk_count = 0;
    wire pixel_tick = (clk_count == 2'd0);
    
    always @(posedge clk) begin
        clk_count <= clk_count + 1;
    end
    
    // VGA Counters
    reg [9:0] hcnt = 0;
    reg [9:0] vcnt = 0;
    
    always @(posedge clk) begin
        if (pixel_tick) begin
            if (hcnt == 799) begin
                hcnt <= 0;
                if (vcnt == 524) begin
                    vcnt <= 0;
                end else begin
                    vcnt <= vcnt + 1;
                end
            end else begin
                hcnt <= hcnt + 1;
            end
        end
    end
    
    // Sync signals
    always @(posedge clk) begin
        Hsync <= ~((hcnt >= 656) && (hcnt < 752));
        Vsync <= ~((vcnt >= 490) && (vcnt < 492));
    end
    
    wire video_on = (hcnt < 640) && (vcnt < 480);
    
    // Double T logo pattern
    reg [8:0] logo_pattern [0:9];
    initial begin
        logo_pattern[0] = 9'b111111111;
        logo_pattern[1] = 9'b100010001;
        logo_pattern[2] = 9'b100010001;
        logo_pattern[3] = 9'b000010000;
        logo_pattern[4] = 9'b001111100;
        logo_pattern[5] = 9'b001010100;
        logo_pattern[6] = 9'b000010000;
        logo_pattern[7] = 9'b000010000;
        logo_pattern[8] = 9'b000010000;
        logo_pattern[9] = 9'b000111000;
    end
    
    parameter LOGO_WIDTH = 72;
    parameter LOGO_HEIGHT = 80;
    wire [10:0] logo_x = (640 - LOGO_WIDTH) / 2;
    wire [10:0] logo_y = (480 - LOGO_HEIGHT) / 2;
    
    // GAME OVER text pattern
    reg [33:0] gameover_text [0:18];
    initial begin
        gameover_text[0] = 34'b0111100000011000011100011101111110;
        gameover_text[1] = 34'b1000010000100100001000001000100010;
        gameover_text[2] = 34'b1000000001000010001100011000100000;
        gameover_text[3] = 34'b1000000001000010001010101000111100;
        gameover_text[4] = 34'b1000110001111110001001001000100000;
        gameover_text[5] = 34'b1000010001000010001001001000100000;
        gameover_text[6] = 34'b1000010001000010001000001000100010;
        gameover_text[7] = 34'b0111100011100111011100011101111110;
        gameover_text[8] = 34'b0000000000000000000000000000000000;
        gameover_text[9] = 34'b0000000000000000000000000000000000;
        gameover_text[10] = 34'b0000000000000000000000000000000000;
        gameover_text[11] = 34'b0111100011100011100111111001111100;
        gameover_text[12] = 34'b1000010001000001000010001000100010;
        gameover_text[13] = 34'b1000010001000001000010000000100010;
        gameover_text[14] = 34'b1000010000100010000011110000111100;
        gameover_text[15] = 34'b1000010000100010000010000000101000;
        gameover_text[16] = 34'b1000010000010100000010000000100100;
        gameover_text[17] = 34'b1000010000010100000010001000100010;
        gameover_text[18] = 34'b0111100000001000000111111001110011;
    end
    
    parameter GAMEOVER_WIDTH = 34 * 4;   // Scale 4x
    parameter GAMEOVER_HEIGHT = 19 * 4;  // Scale 4x
    wire [10:0] gameover_x = (640 - GAMEOVER_WIDTH) / 2;
    wire [10:0] gameover_y = (480 - GAMEOVER_HEIGHT) / 2;
    
    // RAIDER RED SPRITE FUNCTIONS
    function automatic raider_mask_bit;
        input [39:0] rowmask;
        input [5:0]  x;
        begin
            raider_mask_bit = rowmask[39 - x];
        end
    endfunction
    
    function automatic [39:0] white_row;
        input [5:0] y;
        begin
            case (y)
                6'd0:  white_row = 40'b0000000000000000000000000000000000000000;
                6'd1:  white_row = 40'b0000000000000000000000000000000000000000;
                6'd2:  white_row = 40'b0000000000000000000000000000000000000000;
                6'd3:  white_row = 40'b0000000000000000000111000000000000000000;
                6'd4:  white_row = 40'b0000000000000000111111110000000000000000;
                6'd5:  white_row = 40'b0000000000000001110110011000000000000000;
                6'd6:  white_row = 40'b0000000000000001001111101000000000000000;
                6'd7:  white_row = 40'b0000000000000001011111101000000000000000;
                6'd8:  white_row = 40'b0000000000000010011111110100000000000000;
                6'd9:  white_row = 40'b0001100000000000000000000000000000011100;
                6'd10: white_row = 40'b0001110000000000000000000000000000111100;
                6'd11: white_row = 40'b0111110000000000000000000000000000111110;
                6'd12: white_row = 40'b0111110000000000000000000000000000111110;
                6'd13: white_row = 40'b0111110000000000000000000000000000111110;
                6'd14: white_row = 40'b0111111100000000000000000000000001111110;
                6'd15: white_row = 40'b0111111110000000000000000000000111111110;
                6'd16: white_row = 40'b0111111100000000000000000000000011111110;
                6'd17: white_row = 40'b0111111000000000000000000000000001111110;
                6'd18: white_row = 40'b0111110000000000000000000000000000111110;
                6'd19: white_row = 40'b0001110000000000000000000000000000111100;
                6'd20: white_row = 40'b0000100010000011000000001100000110010000;
                6'd21: white_row = 40'b0000001111000001100000011000001111000000;
                6'd22: white_row = 40'b0000000111000001100000011000001111000000;
                6'd23: white_row = 40'b0000000011100001000110001000011110000000;
                6'd24: white_row = 40'b0000000000000000001111100000000000000000;
                6'd25: white_row = 40'b0000000000000000001111100000000000000000;
                6'd26: white_row = 40'b0000000000000000000111000000000000000000;
                6'd27: white_row = 40'b0000000000000000000110000000000000000000;
                6'd28: white_row = 40'b0000000000000000000110000000000000000000;
                6'd29: white_row = 40'b0000000000000000000000000000000000000000;
                6'd30: white_row = 40'b0000000000000000000000000000000000000000;
                6'd31: white_row = 40'b0000000000000000000000000000000000000000;
                6'd32: white_row = 40'b0000000000000000000000000000000000000000;
                6'd33: white_row = 40'b0000000000000000000000000000000000000000;
                6'd34: white_row = 40'b0000000000000000000110000000000000000000;
                6'd35: white_row = 40'b0000000000000000001111000000000000000000;
                6'd36: white_row = 40'b0000000000000000001111000000000000000000;
                6'd37: white_row = 40'b0000000000000000000110000000000000000000;
                6'd38: white_row = 40'b0000000000000000000000000000000000000000;
                6'd39: white_row = 40'b0000000000000000000000000000000000000000;
                default: white_row = 40'b0000000000000000000000000000000000000000;
            endcase
        end
    endfunction
    
    function automatic [39:0] red_row;
        input [5:0] y;
        begin
            case (y)
                6'd11: red_row = 40'b0000000010000000000000000000000100000000;
                6'd12: red_row = 40'b0000000010000000000000000000000110000000;
                6'd13: red_row = 40'b0000000011000000000000000000001100000000;
                6'd14: red_row = 40'b0000000001111000000000000000111000000000;
                6'd15: red_row = 40'b0000000000011110000000000111100000000000;
                6'd16: red_row = 40'b0000000001100011111001111100011000000000;
                6'd17: red_row = 40'b0000000001100011111001111100011000000000;
                6'd18: red_row = 40'b0000000001100001111001111000011000000000;
                6'd25: red_row = 40'b0000000000111110000000000111110000000000;
                6'd26: red_row = 40'b0100001111111111100000011111111111000010;
                6'd27: red_row = 40'b0110001111111111110000011111111111000110;
                6'd28: red_row = 40'b0111001111111111110000111111111111001110;
                6'd29: red_row = 40'b0001111111111111111001111111111111111100;
                6'd30: red_row = 40'b0000111111111111111001111111111111110000;
                6'd31: red_row = 40'b0000011111111111111001111111111111100000;
                6'd32: red_row = 40'b0000001111111111110000111111111111000000;
                6'd33: red_row = 40'b0000001111111111100000011111111111000000;
                6'd34: red_row = 40'b0000000011111111000000001111111110000000;
                default: red_row = 40'b0000000000000000000000000000000000000000;
            endcase
        end
    endfunction
    
    function automatic [39:0] gray_row;
        input [5:0] y;
        begin
            case (y)
                6'd0:  gray_row = 40'b0000000000000000000110000000000000000000;
                6'd1:  gray_row = 40'b0000000000000000001111000000000000000000;
                6'd2:  gray_row = 40'b0000000000000000011001100000000000000000;
                6'd3:  gray_row = 40'b0000000000000000111000110000000000000000;
                6'd4:  gray_row = 40'b0000000000000011000000001100000000000000;
                6'd5:  gray_row = 40'b0000000000000010000000000100000000000000;
                6'd6:  gray_row = 40'b0000000000000110000000000110000000000000;
                6'd7:  gray_row = 40'b0000000000000110000000000111000000000000;
                6'd8:  gray_row = 40'b0001100000000100000000000011000000011100;
                6'd9:  gray_row = 40'b0110011100000111111111111111000001100010;
                6'd10: gray_row = 40'b0110001110000000000000000000000111000010;
                6'd11: gray_row = 40'b1000001101100000000000000000011011000001;
                6'd12: gray_row = 40'b1000001101110000000000000000111001000001;
                6'd13: gray_row = 40'b1000001100111111111111111111110001000001;
                6'd14: gray_row = 40'b1000000010000111111111111111000110000001;
                6'd15: gray_row = 40'b1000000001100001111111111000011000000001;
                6'd16: gray_row = 40'b1000000010011100000111000001100100000001;
                6'd17: gray_row = 40'b1000000110011000000110000001100110000001;
                6'd18: gray_row = 40'b1000001110011000000110000000100111000001;
                6'd19: gray_row = 40'b0110001111100111111111111111011111000010;
                6'd20: gray_row = 40'b0111011101000100111111110011001001101110;
                6'd21: gray_row = 40'b0011111000100110011111100111010000111100;
                6'd22: gray_row = 40'b0001111000101110011111100111010000111000;
                6'd23: gray_row = 40'b0000111100011110111001110111100001110000;
                6'd24: gray_row = 40'b1000011111111111110000011111111111100001;
                6'd25: gray_row = 40'b1100001111000001110000011000001111000011;
                6'd26: gray_row = 40'b1100010000000000000000100000000000100111;
                6'd27: gray_row = 40'b1001010000000000001001100000000000101001;
                6'd28: gray_row = 40'b1000110000000000001001100000000000110001;
                6'd29: gray_row = 40'b0110000000000000000110000000000000000010;
                6'd30: gray_row = 40'b0001000000000000000110000000000000001100;
                6'd31: gray_row = 40'b0001100000000000000110000000000000001100;
                6'd32: gray_row = 40'b0001100000000000000111000000000000011000;
                6'd33: gray_row = 40'b0000110000000000001111100000000000110000;
                6'd34: gray_row = 40'b0000011100000000111001110000000001100000;
                6'd35: gray_row = 40'b0000001111111111110000111111111111000000;
                6'd36: gray_row = 40'b0000000111111111110000111111111110000000;
                6'd37: gray_row = 40'b0000000000000001111001111000000000000000;
                6'd38: gray_row = 40'b0000000000000000001111100000000000000000;
                default: gray_row = 40'b0000000000000000000000000000000000000000;
            endcase
        end
    endfunction
    
    function automatic [39:0] black_row;
        input [5:0] y;
        begin
            case (y)
                6'd5:  black_row = 40'b0000000000000000001001100000000000000000;
                6'd6:  black_row = 40'b0000000000000000110000010000000000000000;
                6'd7:  black_row = 40'b0000000000000000100000010000000000000000;
                6'd8:  black_row = 40'b0000000000000001000000001000000000000000;
                6'd10: black_row = 40'b0000000000000111111111111111000000000000;
                6'd11: black_row = 40'b0000000000000111111111111111000000000000;
                6'd12: black_row = 40'b0000000000000111111111111110000000000000;
                6'd18: black_row = 40'b0000000000000110000000000111000000000000;
                6'd19: black_row = 40'b0000000000011000000000000000100000000000;
                6'd20: black_row = 40'b0000000000111000000000000000110000000000;
                6'd21: black_row = 40'b0000000000011000000000000000100000000000;
                6'd22: black_row = 40'b0000000000000000000000000000000000000000;
                6'd23: black_row = 40'b0000000000000000100000010000000000000000;
                default: black_row = 40'b0000000000000000000000000000000000000000;
            endcase
        end
    endfunction
    
    // Game parameters
    parameter SCALE = 4;
    parameter RAIDER_WIDTH = 40 * SCALE;   // 160 pixels
    parameter RAIDER_HEIGHT = 40 * SCALE;  // 160 pixels
    parameter PLAYER_SIZE = 8;
    
    reg game_over = 0;
    
    // Movement speed divider
    reg [19:0] move_counter = 0;
    wire move_tick = (move_counter == 20'd833332);  // ~30 updates per second
    
    always @(posedge clk) begin
        if (move_tick) begin
            move_counter <= 0;
        end else begin
            move_counter <= move_counter + 1;
        end
    end
    
    // Raider Red position and velocity
    reg [10:0] raider_x = 11'd100;
    reg [10:0] raider_y = 11'd100;
    reg [1:0] vel_x = 2'd2;      
    reg [1:0] vel_y = 2'd2;
    reg dir_x = 1;  // 1 = right, 0 = left
    reg dir_y = 1;  // 1 = down, 0 = up
    
    // Bounce logic
    always @(posedge clk) begin
        if (move_tick && !game_over) begin
            // Update X position
            if (dir_x) begin
                raider_x <= raider_x + vel_x;
            end else begin
                raider_x <= raider_x - vel_x;
            end
            
            // Update Y position
            if (dir_y) begin
                raider_y <= raider_y + vel_y;
            end else begin
                raider_y <= raider_y - vel_y;
            end
            
            // Check X boundaries
            if (dir_x && (raider_x + vel_x >= (640 - RAIDER_WIDTH))) begin
                dir_x <= 0;  // Start moving left
            end else if (!dir_x && (raider_x <= vel_x)) begin
                dir_x <= 1;  // Start moving right
            end
            
            // Check Y boundaries  
            if (dir_y && (raider_y + vel_y >= (480 - RAIDER_HEIGHT))) begin
                dir_y <= 0;  // Start moving up
            end else if (!dir_y && (raider_y <= vel_y)) begin
                dir_y <= 1;  // Start moving down
            end
        end
    end
    
    // Player
    reg [9:0] player_x = 10'd320;  
    reg [9:0] player_y = 10'd400;  
    
    // Buttons
    reg [19:0] btn_counter = 0;
    wire btn_tick = (btn_counter == 20'd1666666);
    
    always @(posedge clk) begin
        btn_counter <= btn_tick ? 0 : btn_counter + 1;
    end
    
    reg BTNU_sync = 0, BTNL_sync = 0, BTNR_sync = 0, BTNC_sync = 0, BTND_sync = 0;
    reg BTNU_prev = 0, BTNL_prev = 0, BTNR_prev = 0, BTNC_prev = 0, BTND_prev = 0;
    
    always @(posedge clk) if (btn_tick) begin
        BTNU_sync <= BTNU; BTNL_sync <= BTNL; BTNR_sync <= BTNR;
        BTNC_sync <= BTNC; BTND_sync <= BTND;
        BTNU_prev <= BTNU_sync; BTNL_prev <= BTNL_sync; BTNR_prev <= BTNR_sync;
        BTNC_prev <= BTNC_sync; BTND_prev <= BTND_sync;
    end
    
    wire reset_pressed = BTND_sync && !BTND_prev;
    
    // Collision detection
    wire collision = (player_x + PLAYER_SIZE > raider_x) && 
                     (player_x < raider_x + RAIDER_WIDTH) && 
                     (player_y + PLAYER_SIZE > raider_y) && 
                     (player_y < raider_y + RAIDER_HEIGHT);
    
    // Player movement - freezes when game over
    always @(posedge clk) if (btn_tick) begin
        if (reset_pressed) begin
            game_over <= 0;
            player_x <= 320;
            player_y <= 400;
            raider_x <= 11'd100;
            raider_y <= 11'd100;
            vel_x <= 2'd2;
            vel_y <= 2'd2;
            dir_x <= 1;
            dir_y <= 1;
        end else begin
            if (collision && !game_over) begin
                game_over <= 1;
            end
            
            // Player can only move if game not over
            if (!game_over) begin
                if (BTNU_sync && player_y > 0) player_y <= player_y - 2;
                if (BTNL_sync && player_y < 472) player_y <= player_y + 2;
                if (BTNR_sync && player_x > 0) player_x <= player_x - 2;
                if (BTNC_sync && player_x < 632) player_x <= player_x + 2;
            end
        end
    end
    
    // Raider sprite rendering
    wire [10:0] raider_rel_x = hcnt - raider_x;
    wire [10:0] raider_rel_y = vcnt - raider_y;
    wire in_raider = (raider_rel_x < RAIDER_WIDTH) && (raider_rel_y < RAIDER_HEIGHT);
    
    wire [5:0] rpx = raider_rel_x / SCALE;
    wire [5:0] rpy = raider_rel_y / SCALE;
    
    wire raider_sprite_on;
    wire [3:0] raider_r, raider_g, raider_b;
    
    assign raider_sprite_on = in_raider && (
        raider_mask_bit(white_row(rpy), rpx) ||
        raider_mask_bit(red_row(rpy), rpx) ||
        raider_mask_bit(gray_row(rpy), rpx) ||
        raider_mask_bit(black_row(rpy), rpx)
    );
    
    assign raider_r = !raider_sprite_on ? 4'h0 :
                      raider_mask_bit(black_row(rpy), rpx) ? 4'h0 :
                      raider_mask_bit(white_row(rpy), rpx) ? 4'hF :
                      raider_mask_bit(red_row(rpy), rpx)   ? 4'hF :
                      raider_mask_bit(gray_row(rpy), rpx)  ? 4'h4 : 4'h0;
    
    assign raider_g = !raider_sprite_on ? 4'h0 :
                      raider_mask_bit(black_row(rpy), rpx) ? 4'h0 :
                      raider_mask_bit(white_row(rpy), rpx) ? 4'hF :
                      raider_mask_bit(red_row(rpy), rpx)   ? 4'h0 :
                      raider_mask_bit(gray_row(rpy), rpx)  ? 4'h4 : 4'h0;
    
    assign raider_b = !raider_sprite_on ? 4'h0 :
                      raider_mask_bit(black_row(rpy), rpx) ? 4'h0 :
                      raider_mask_bit(white_row(rpy), rpx) ? 4'hF :
                      raider_mask_bit(red_row(rpy), rpx)   ? 4'h0 :
                      raider_mask_bit(gray_row(rpy), rpx)  ? 4'h4 : 4'h0;
    
    // Logo
    wire [10:0] logo_rx = hcnt - logo_x;
    wire [10:0] logo_ry = vcnt - logo_y;
    wire logo_on = (logo_rx < LOGO_WIDTH) && (logo_ry < LOGO_HEIGHT) &&
                   logo_pattern[logo_ry/8][8 - logo_rx/8];
    
    // Game Over text
    wire [10:0] gameover_rx = hcnt - gameover_x;
    wire [10:0] gameover_ry = vcnt - gameover_y;
    wire gameover_on = game_over && 
                       (gameover_rx < GAMEOVER_WIDTH) && 
                       (gameover_ry < GAMEOVER_HEIGHT) &&
                       gameover_text[gameover_ry/4][33 - gameover_rx/4];
    
    // Player sprite - green when alive, red when dead
    wire player_on = (hcnt >= player_x) && (hcnt < player_x + PLAYER_SIZE) &&
                     (vcnt >= player_y) && (vcnt < player_y + PLAYER_SIZE);
    
    // Final color output
    always @(posedge clk) begin
        if (video_on) begin
            if (gameover_on) begin
                // White game over text
                Red   <= 4'hF;
                Green <= 4'hF;
                Blue  <= 4'hF;
            end else if (player_on) begin
                if (game_over) begin
                    // Red when dead
                    Red   <= 4'hF;
                    Green <= 4'h0;
                    Blue  <= 4'h0;
                end else begin
                    // Green when alive
                    Red   <= 4'h0;
                    Green <= 4'hF;
                    Blue  <= 4'h0;
                end
            end else if (raider_sprite_on) begin
                Red   <= raider_r;
                Green <= raider_g;
                Blue  <= raider_b;
            end else if (logo_on) begin
                Red   <= 4'hF;
                Green <= 4'h0;
                Blue  <= 4'h0;
            end else begin
                Red   <= 4'h0;
                Green <= 4'h0;
                Blue  <= 4'h0;
            end
        end else begin
            Red   <= 4'h0;
            Green <= 4'h0;
            Blue  <= 4'h0;
        end
    end
endmodule
