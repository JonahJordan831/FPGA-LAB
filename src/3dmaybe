reg [5:0] angle_idx = 6'd0;
wire signed [15:0] dir_x   = angle_table[angle_idx][0];
wire signed [15:0] dir_y   = angle_table[angle_idx][1];
wire signed [15:0] plane_x = angle_table[angle_idx][2];
wire signed [15:0] plane_y = angle_table[angle_idx][3];

// ─── Map ──────────────────────────────────────────────────────────────────────
reg [3:0] map_data [0:255];
wire [1023:0] map_flat;
integer mi;
initial begin
    for (mi=0; mi<256; mi=mi+1) map_data[mi]=4'd0;
    begin : fb integer bi;
        for (bi=0; bi<16; bi=bi+1) begin
            map_data[  0*16+bi]=4'd1; map_data[15*16+bi]=4'd1;
            map_data[bi*16+  0]=4'd1; map_data[bi*16+15]=4'd1;
        end
    end
    map_data[ 2*16+2]=4'd2; map_data[ 2*16+3]=4'd2; map_data[2*16+4]=4'd2;
    map_data[ 3*16+4]=4'd2; map_data[ 4*16+4]=4'd2;
    map_data[ 2*16+9]=4'd3; map_data[ 3*16+9]=4'd3;
    map_data[ 4*16+9]=4'd3; map_data[ 4*16+8]=4'd3;
    map_data[ 7*16+2]=4'd4; map_data[ 7*16+3]=4'd4;
    map_data[ 8*16+6]=4'd2; map_data[ 9*16+6]=4'd2;
    map_data[ 9*16+7]=4'd2; map_data[ 9*16+8]=4'd2;
    map_data[ 6*16+12]=4'd3; map_data[7*16+12]=4'd3;
    map_data[11*16+3]=4'd4; map_data[11*16+4]=4'd4;
    map_data[12*16+5]=4'd4; map_data[13*16+5]=4'd4;
    map_data[11*16+9]=4'd1; map_data[11*16+10]=4'd1;
    map_data[13*16+10]=4'd1; map_data[13*16+11]=4'd1;
end
genvar gmi2;
generate
    for (gmi2=0; gmi2<256; gmi2=gmi2+1)
        assign map_flat[gmi2*4 +: 4] = map_data[gmi2];
endgenerate

// ─── Player ───────────────────────────────────────────────────────────────────
reg signed [15:0] pos_x = 16'h0380;
reg signed [15:0] pos_y = 16'h0380;

// ─── Double frame buffer via xpm_memory_sdpram ────────────────────────────────
// buf0: written when write_buf==0, read when write_buf==1 (and vice versa)
// buf1: written when write_buf==1, read when write_buf==0
reg        write_buf = 1'b0;

// Write port signals (raycaster side)
reg        fb_we    = 1'b0;
reg [8:0]  fb_waddr = 9'd0;
reg [19:0] fb_wdata = 20'd0;

// Read port signals (VGA side) — address registered one cycle ahead
wire [8:0]  scol    = hcnt[9:1];
wire [19:0] fb0_rdata, fb1_rdata;

xpm_sdpram_wrap buf0 (
    .clk   (CLK),
    .we    (fb_we && (write_buf == 1'b0)),
    .waddr (fb_waddr),
    .wdata (fb_wdata),
    .raddr (scol),
    .rdata (fb0_rdata)
);

xpm_sdpram_wrap buf1 (
    .clk   (CLK),
    .we    (fb_we && (write_buf == 1'b1)),
    .waddr (fb_waddr),
    .wdata (fb_wdata),
    .raddr (scol),
    .rdata (fb1_rdata)
);

// Select the buffer not currently being written for display
wire [19:0] vga_entry = (write_buf == 1'b1) ? fb0_rdata : fb1_rdata;

// ─── RayCaster ────────────────────────────────────────────────────────────────
reg  [8:0] cam_x      = 9'd0;
wire [7:0] line_height_out;
wire [3:0] line_color_out;
wire       cast_busy, cast_done;
reg        cast_start = 1'b0;
reg  [7:0] lh_latch   = 8'd0;
reg  [3:0] lc_latch   = 4'd0;

RayCaster rc (
    .clk(CLK), .rst(rst), .cam_x(cam_x),
    .pos_x(pos_x), .pos_y(pos_y),
    .dir_x(dir_x), .dir_y(dir_y),
    .plane_x(plane_x), .plane_y(plane_y),
    .map_flat(map_flat),
    .start(cast_start), .busy(cast_busy), .done(cast_done),
    .line_height(line_height_out), .line_color(line_color_out)
);

// ─── Frame orchestrator FSM ───────────────────────────────────────────────────
localparam [1:0] FS_WAIT=2'd0, FS_MOVE=2'd1, FS_CAST=2'd2, FS_STORE=2'd3;
reg [1:0] fs = FS_WAIT;

always @(posedge CLK) begin
    if (rst) begin
        fs<=FS_WAIT; cam_x<=0; cast_start<=0;
        pos_x<=16'h0380; pos_y<=16'h0380; angle_idx<=0;
        write_buf<=0; lh_latch<=0; lc_latch<=0;
        fb_we<=0; fb_waddr<=0; fb_wdata<=0;
    end else begin
        fb_we <= 1'b0; // default: no write

        case (fs)
        FS_WAIT: begin
            cast_start <= 1'b0;
            if (frame_start) begin
                write_buf <= ~write_buf;
                fs        <= FS_MOVE;
            end
        end

        FS_MOVE: begin : do_move
            reg signed [15:0] nx, ny; reg [3:0] mcx, mcy;
            nx=pos_x; ny=pos_y;
            if (btn_u) begin nx=pos_x+(dir_x>>>7); ny=pos_y+(dir_y>>>7); end
            if (btn_d) begin nx=pos_x-(dir_x>>>7); ny=pos_y-(dir_y>>>7); end
            mcx=nx[11:8]; mcy=ny[11:8];
            if      (map_data[{mcy,mcx}]        ==4'd0) begin pos_x<=nx; pos_y<=ny; end
            else if (map_data[{pos_y[11:8],mcx}]==4'd0) pos_x<=nx;
            else if (map_data[{mcy,pos_x[11:8]}]==4'd0) pos_y<=ny;
            if (btn_l) angle_idx<=angle_idx-6'd1;
            if (btn_r) angle_idx<=angle_idx+6'd1;
            if (btn_c) begin pos_x<=16'h0380; pos_y<=16'h0380; angle_idx<=0; end
            cam_x<=9'd0; fs<=FS_CAST;
        end

        FS_CAST: begin
            if (!cast_busy && !cast_done) cast_start<=1'b1;
            if (cast_done) begin
                cast_start<=1'b0;
                lh_latch<=line_height_out;
                lc_latch<=line_color_out;
                fs<=FS_STORE;
            end
        end

        FS_STORE: begin : do_store
            reg [7:0] half, top8, bot8;
            half = {1'b0, lh_latch[7:1]};
            top8 = (half>=8'd120) ? 8'd0   : (8'd120-half);
            bot8 = (half>=8'd120) ? 8'd240 : (8'd120+half);
            fb_we    <= 1'b1;
            fb_waddr <= cam_x;
            fb_wdata <= {bot8, top8, lc_latch};
            if (cam_x==9'd319) begin cam_x<=9'd0; fs<=FS_WAIT; end
            else               begin cam_x<=cam_x+9'd1; fs<=FS_CAST; end
        end

        default: fs<=FS_WAIT;
        endcase
    end
end

// ─── VGA pixel output ─────────────────────────────────────────────────────────
wire [7:0] srow = vcnt[8:1];

// BRAM read latency is 1 cycle — vga_entry is already one cycle delayed
wire [7:0] wtop = vga_entry[11:4];
wire [7:0] wbot = vga_entry[19:12];
wire [3:0] wcol = vga_entry[3:0];

wire is_wall = (srow >= wtop) && (srow < wbot);
wire is_ceil = (srow < wtop);

reg [3:0] R=0, G=0, B=0;
always @(posedge CLK) begin
    if (!video_on) begin R<=0; G<=0; B<=0;
    end else if (is_wall) begin
        case (wcol[2:0])
            3'd1: begin R<=wcol[3]?4'd7:4'd12; G<=wcol[3]?4'd1:4'd2;  B<=wcol[3]?4'd1:4'd2;  end
            3'd2: begin R<=wcol[3]?4'd1:4'd2;  G<=wcol[3]?4'd6:4'd10; B<=wcol[3]?4'd1:4'd2;  end
            3'd3: begin R<=wcol[3]?4'd1:4'd2;  G<=wcol[3]?4'd2:4'd3;  B<=wcol[3]?4'd7:4'd12; end
            3'd4: begin R<=wcol[3]?4'd8:4'd13; G<=wcol[3]?4'd6:4'd10; B<=4'd1;                end
            default: begin R<=4'd5; G<=4'd5; B<=4'd5; end
        endcase
    end else if (is_ceil) begin R<=4'd3; G<=4'd3; B<=4'd6;
    end else              begin R<=4'd6; G<=4'd4; B<=4'd1; end
end

assign VGA_R = R;
assign VGA_G = G;
assign VGA_B = B;

endmodule
`default_nettype wire
