`timescale 1ns / 1ps
`default_nettype none
//==============================================================================
// raycaster_top.v  —  All-in-one Wolfenstein-style raycaster
// Basys3 100MHz,  VGA 640x480 @ 60Hz,  320x240 internal doubled to 640x480
// Controls:  BTNU=fwd  BTND=back  BTNL=turn left  BTNR=turn right  BTNC=reset
//==============================================================================

//==============================================================================
// RayCaster module
//==============================================================================
module RayCaster (
    input  wire        clk,
    input  wire        rst,
    input  wire [8:0]  cam_x,

    input  wire signed [15:0] pos_x,
    input  wire signed [15:0] pos_y,
    input  wire signed [15:0] dir_x,
    input  wire signed [15:0] dir_y,
    input  wire signed [15:0] plane_x,
    input  wire signed [15:0] plane_y,

    input  wire [1023:0] map_flat,

    input  wire        start,
    output reg         busy,
    output reg         done,

    output wire [7:0]  line_height,
    output wire [3:0]  line_color
);

wire [3:0] map_data [0:255];
genvar gmi;
generate
    for (gmi = 0; gmi < 256; gmi = gmi + 1)
        assign map_data[gmi] = map_flat[gmi*4 +: 4];
endgenerate

function signed [15:0] trunc_mul;
    input signed [31:0] m;
    begin trunc_mul = m[23:8]; end
endfunction

reg [15:0] recip [1:255];
integer ri;
initial begin
    for (ri = 1; ri < 256; ri = ri + 1)
        recip[ri] = 32768 / ri;
end

localparam [3:0]
    IDLE         = 4'd0,
    MULTIPLY     = 4'd1,
    RAY_CALC     = 4'd2,
    RAY_CALC_X   = 4'd3,
    RAY_CALC_Y   = 4'd4,
    DELTADIST    = 4'd5,
    START_CAST   = 4'd6,
    DDA_FIND_HIT = 4'd7,
    CALC_DIST    = 4'd8,
    FIND_HEIGHT  = 4'd9,
    DONE_STATE   = 4'd10;

reg [3:0] state_q = IDLE, state_d;
reg [3:0] next_state_q = IDLE, next_state_d;

reg signed [15:0] raydir_x_q,    raydir_x_d;
reg signed [15:0] raydir_y_q,    raydir_y_d;
reg signed [15:0] delta_n_x_q,   delta_n_x_d;
reg signed [15:0] delta_n_y_q,   delta_n_y_d;
reg        [15:0] delta_x_q,     delta_x_d;
reg        [15:0] delta_y_q,     delta_y_d;
reg        [15:0] side_dist_x_q, side_dist_x_d;
reg        [15:0] side_dist_y_q, side_dist_y_d;
reg signed [15:0] step_x_q,      step_x_d;
reg signed [15:0] step_y_q,      step_y_d;
reg        [15:0] sidestep_x_q,  sidestep_x_d;
reg        [15:0] sidestep_y_q,  sidestep_y_d;
reg        [15:0] map_x_q,       map_x_d;
reg        [15:0] map_y_q,       map_y_d;
reg               side_q,        side_d;
reg signed [15:0] p_wall_dist_q, p_wall_dist_d;
reg signed [15:0] mul_arg1_q,    mul_arg1_d;
reg signed [15:0] mul_arg2_q,    mul_arg2_d;
reg signed [15:0] mul_res_q,     mul_res_d;
reg signed [15:0] camerax_q,     camerax_d;
reg        [3:0]  color_q,       color_d;
reg        [7:0]  lh_q,          lh_d;
reg        [5:0]  dda_iter_q,    dda_iter_d;

localparam signed [15:0] ONE_Q214    = 16'sh4000;
localparam signed [15:0] NEG_ONE_Q88 = 16'shFF00;
localparam signed [15:0] POS_ONE_Q88 = 16'sh0100;

always @(*) begin
    state_d       = state_q;       next_state_d  = next_state_q;
    raydir_x_d    = raydir_x_q;    raydir_y_d    = raydir_y_q;
    delta_n_x_d   = delta_n_x_q;   delta_n_y_d   = delta_n_y_q;
    delta_x_d     = delta_x_q;     delta_y_d     = delta_y_q;
    side_dist_x_d = side_dist_x_q; side_dist_y_d = side_dist_y_q;
    step_x_d      = step_x_q;      step_y_d      = step_y_q;
    sidestep_x_d  = sidestep_x_q;  sidestep_y_d  = sidestep_y_q;
    map_x_d       = map_x_q;       map_y_d       = map_y_q;
    side_d        = side_q;
    p_wall_dist_d = p_wall_dist_q;
    mul_arg1_d    = mul_arg1_q;     mul_arg2_d    = mul_arg2_q;
    mul_res_d     = mul_res_q;
    camerax_d     = camerax_q;
    color_d       = color_q;
    lh_d          = lh_q;
    dda_iter_d    = dda_iter_q;
    busy          = 1'b1;
    done          = 1'b0;

    case (state_q)
    IDLE: begin
        busy = 1'b0;
        if (start) begin
            camerax_d  = ($signed({7'd0, cam_x}) * $signed(16'sh0066)) - ONE_Q214;
            dda_iter_d = 6'd0;
            state_d    = RAY_CALC;
        end
    end
    MULTIPLY: begin
        mul_res_d = trunc_mul($signed(mul_arg1_q) * $signed(mul_arg2_q));
        state_d   = next_state_q;
    end
    RAY_CALC: begin
        mul_arg1_d = plane_x; mul_arg2_d = camerax_q;
        next_state_d = RAY_CALC_X; state_d = MULTIPLY;
    end
    RAY_CALC_X: begin
        raydir_x_d = dir_x + mul_res_q;
        mul_arg1_d = plane_y; next_state_d = RAY_CALC_Y; state_d = MULTIPLY;
    end
    RAY_CALC_Y: begin
        raydir_y_d = dir_y + mul_res_q; state_d = DELTADIST;
    end
    DELTADIST: begin : dd_block
        reg [15:0] abs_rdx, abs_rdy; reg [7:0] ax, ay;
        abs_rdx = raydir_x_q[15] ? (16'd0-raydir_x_q) : raydir_x_q;
        abs_rdy = raydir_y_q[15] ? (16'd0-raydir_y_q) : raydir_y_q;
        ax = abs_rdx[15:8]; ay = abs_rdy[15:8];
        if (ax==8'd0) begin delta_x_d=16'h7FFF; delta_n_x_d=16'sh7FFF; end
        else begin delta_x_d=recip[ax];
            delta_n_x_d=raydir_x_q[15]?-$signed({1'b0,recip[ax]}):$signed({1'b0,recip[ax]}); end
        if (ay==8'd0) begin delta_y_d=16'h7FFF; delta_n_y_d=16'sh7FFF; end
        else begin delta_y_d=recip[ay];
            delta_n_y_d=raydir_y_q[15]?-$signed({1'b0,recip[ay]}):$signed({1'b0,recip[ay]}); end
        state_d = START_CAST;
    end
    START_CAST: begin : sc_block
        reg [31:0] sdx_mul, sdy_mul;
        if (raydir_x_q[15]) begin step_x_d=NEG_ONE_Q88; sidestep_x_d=16'h0100; end
        else                begin step_x_d=POS_ONE_Q88; sidestep_x_d=16'h0000; end
        if (raydir_y_q[15]) begin step_y_d=NEG_ONE_Q88; sidestep_y_d=16'h0100; end
        else                begin step_y_d=POS_ONE_Q88; sidestep_y_d=16'h0000; end
        map_x_d = pos_x & 16'hFF00;
        map_y_d = pos_y & 16'hFF00;
        sdx_mul = raydir_x_q[15] ?
            ({8'd0, pos_x[7:0], 8'd0}*{16'd0,delta_x_q}) :
            ({8'd0,~pos_x[7:0], 8'd0}*{16'd0,delta_x_q});
        sdy_mul = raydir_y_q[15] ?
            ({8'd0, pos_y[7:0], 8'd0}*{16'd0,delta_y_q}) :
            ({8'd0,~pos_y[7:0], 8'd0}*{16'd0,delta_y_q});
        side_dist_x_d = sdx_mul[23:8];
        side_dist_y_d = sdy_mul[23:8];
        dda_iter_d = 6'd0; state_d = DDA_FIND_HIT;
    end
    DDA_FIND_HIT: begin : dda_block
        reg [3:0] mcx, mcy, hit; reg [15:0] mx_next, my_next;
        if (side_dist_x_q < side_dist_y_q) begin
            side_dist_x_d=side_dist_x_q+delta_x_q; mx_next=map_x_q+step_x_q; my_next=map_y_q; side_d=1'b0;
        end else begin
            side_dist_y_d=side_dist_y_q+delta_y_q; mx_next=map_x_q; my_next=map_y_q+step_y_q; side_d=1'b1;
        end
        map_x_d=mx_next; map_y_d=my_next;
        mcx=mx_next[11:8]; mcy=my_next[11:8];
        if (mcx>4'd15 || mcy>4'd15) begin color_d=4'd0; lh_d=8'd0; state_d=DONE_STATE; end
        else begin
            hit=map_data[{mcy,mcx}]; dda_iter_d=dda_iter_q+6'd1;
            if      (hit!=4'd0)           begin color_d={side_d,hit[2:0]}; dda_iter_d=6'd0; state_d=CALC_DIST; end
            else if (dda_iter_q>=6'd62)   begin color_d=4'd0; lh_d=8'd0; dda_iter_d=6'd0; state_d=DONE_STATE; end
        end
    end
    CALC_DIST: begin
        mul_arg1_d = side_q ? ($signed(map_y_q)-$signed(pos_y)+$signed(sidestep_y_q))
                            : ($signed(map_x_q)-$signed(pos_x)+$signed(sidestep_x_q));
        mul_arg2_d = side_q ? delta_n_y_q : delta_n_x_q;
        next_state_d=FIND_HEIGHT; state_d=MULTIPLY;
    end
    FIND_HEIGHT: begin : fh_block
        reg [7:0] dist_int, hh; reg [15:0] rv;
        p_wall_dist_d=mul_res_q; dist_int=mul_res_q[15:8];
        if (dist_int==8'd0) hh=8'd240;
        else begin rv=recip[dist_int]; hh=rv[15:7]; if(hh>8'd240) hh=8'd240; end
        lh_d=hh; state_d=DONE_STATE;
    end
    DONE_STATE: begin
        done=1'b1; busy=1'b0;
        if (!start) state_d=IDLE;
    end
    default: state_d=IDLE;
    endcase
end

always @(posedge clk) begin
    if (rst) begin
        state_q<=IDLE; next_state_q<=IDLE;
        raydir_x_q<=0; raydir_y_q<=0; delta_n_x_q<=0; delta_n_y_q<=0;
        delta_x_q<=0; delta_y_q<=0; side_dist_x_q<=0; side_dist_y_q<=0;
        step_x_q<=0; step_y_q<=0; sidestep_x_q<=0; sidestep_y_q<=0;
        map_x_q<=0; map_y_q<=0; side_q<=0; p_wall_dist_q<=0;
        mul_arg1_q<=0; mul_arg2_q<=0; mul_res_q<=0; camerax_q<=0;
        color_q<=0; lh_q<=0; dda_iter_q<=0;
    end else begin
        state_q<=state_d; next_state_q<=next_state_d;
        raydir_x_q<=raydir_x_d; raydir_y_q<=raydir_y_d;
        delta_n_x_q<=delta_n_x_d; delta_n_y_q<=delta_n_y_d;
        delta_x_q<=delta_x_d; delta_y_q<=delta_y_d;
        side_dist_x_q<=side_dist_x_d; side_dist_y_q<=side_dist_y_d;
        step_x_q<=step_x_d; step_y_q<=step_y_d;
        sidestep_x_q<=sidestep_x_d; sidestep_y_q<=sidestep_y_d;
        map_x_q<=map_x_d; map_y_q<=map_y_d; side_q<=side_d;
        p_wall_dist_q<=p_wall_dist_d;
        mul_arg1_q<=mul_arg1_d; mul_arg2_q<=mul_arg2_d; mul_res_q<=mul_res_d;
        camerax_q<=camerax_d; color_q<=color_d; lh_q<=lh_d; dda_iter_q<=dda_iter_d;
    end
end

assign line_height = lh_q;
assign line_color  = color_q;
endmodule


//==============================================================================
// xpm_sdpram_wrap — thin wrapper around xpm_memory_sdpram
// 320 entries x 20 bits, Simple Dual Port (write A / read B), common clock
//==============================================================================
module xpm_sdpram_wrap (
    input  wire        clk,
    input  wire        we,
    input  wire [8:0]  waddr,   // 0-319
    input  wire [19:0] wdata,
    input  wire [8:0]  raddr,
    output wire [19:0] rdata
);
    xpm_memory_sdpram #(
        .ADDR_WIDTH_A        (9),
        .ADDR_WIDTH_B        (9),
        .BYTE_WRITE_WIDTH_A  (20),
        .CLOCKING_MODE       ("common_clock"),
        .ECC_MODE            ("no_ecc"),
        .MEMORY_PRIMITIVE    ("block"),
        .MEMORY_SIZE         (320*20),   // 6400 bits
        .READ_DATA_WIDTH_B   (20),
        .READ_LATENCY_B      (1),
        .WRITE_DATA_WIDTH_A  (20),
        .WRITE_MODE_B        ("no_change"),
        .AUTO_SLEEP_TIME     (0),
        .CASCADE_HEIGHT      (0),
        .MEMORY_INIT_FILE    ("none"),
        .MEMORY_INIT_PARAM   ("0"),
        .MEMORY_OPTIMIZATION ("true"),
        .MESSAGE_CONTROL     (0),
        .RST_MODE_A          ("SYNC"),
        .RST_MODE_B          ("SYNC"),
        .SIM_ASSERT_CHK      (0),
        .USE_EMBEDDED_CONSTRAINT(0),
        .USE_MEM_INIT        (0),
        .WAKEUP_TIME         ("disable_sleep")
    ) u_mem (
        .clka   (clk),   .clkb   (clk),
        .ena    (we),    .enb    (1'b1),
        .wea    (1'b1),
        .addra  (waddr), .addrb  (raddr),
        .dina   (wdata), .doutb  (rdata),
        .rstb   (1'b0),  .regceb (1'b1),
        .sleep  (1'b0),
        .injectdbiterra(1'b0), .injectsbiterra(1'b0),
        .dbiterrb(), .sbiterrb()
    );
endmodule


//==============================================================================
// Top module
//==============================================================================
module top (
    input  wire        CLK,
    input  wire        BTNC, BTNL, BTNR, BTNU, BTND,
    output wire        VGA_HS_O,
    output wire        VGA_VS_O,
    output wire [3:0]  VGA_R,
    output wire [3:0]  VGA_G,
    output wire [3:0]  VGA_B
);

// ─── Reset ────────────────────────────────────────────────────────────────────
reg [3:0] rst_sr = 4'b1111;
wire rst = rst_sr[0];
always @(posedge CLK) rst_sr <= {1'b0, rst_sr[3:1]};

// ─── 25 MHz pixel strobe ──────────────────────────────────────────────────────
reg [1:0] clk_div = 2'd0;
wire pix_stb = (clk_div == 2'd0);
always @(posedge CLK) clk_div <= clk_div + 2'd1;

// ─── VGA timing ───────────────────────────────────────────────────────────────
reg [9:0] hcnt = 10'd0, vcnt = 10'd0;
always @(posedge CLK) begin
    if (pix_stb) begin
        if (hcnt == 10'd799) begin
            hcnt <= 10'd0;
            vcnt <= (vcnt == 10'd524) ? 10'd0 : vcnt + 10'd1;
        end else hcnt <= hcnt + 10'd1;
    end
end

wire video_on    = (hcnt < 10'd640) && (vcnt < 10'd480);
wire vblank      = (vcnt >= 10'd480);
reg  vblank_r    = 1'b0;
always @(posedge CLK) vblank_r <= vblank;
wire frame_start = vblank && !vblank_r;

reg hs_r=1'b1, vs_r=1'b1;
always @(posedge CLK) begin
    hs_r <= ~((hcnt>=10'd656)&&(hcnt<10'd752));
    vs_r <= ~((vcnt>=10'd490)&&(vcnt<10'd492));
end
assign VGA_HS_O = hs_r;
assign VGA_VS_O = vs_r;

// ─── Button debounce ──────────────────────────────────────────────────────────
reg [1:0] sl=0,sr=0,su=0,sd=0,sc_s=0;
always @(posedge CLK) begin
    sl<={sl[0],BTNL}; sr<={sr[0],BTNR};
    su<={su[0],BTNU}; sd<={sd[0],BTND}; sc_s<={sc_s[0],BTNC};
end
reg [19:0] dcl=0,dcr=0,dcu=0,dcd=0,dcc=0;
reg btn_l=0,btn_r=0,btn_u=0,btn_d=0,btn_c=0;
always @(posedge CLK) begin
    if(sl[1]==btn_l)   dcl<=0; else begin dcl<=dcl+1; if(&dcl) btn_l<=sl[1];   end
    if(sr[1]==btn_r)   dcr<=0; else begin dcr<=dcr+1; if(&dcr) btn_r<=sr[1];   end
    if(su[1]==btn_u)   dcu<=0; else begin dcu<=dcu+1; if(&dcu) btn_u<=su[1];   end
    if(sd[1]==btn_d)   dcd<=0; else begin dcd<=dcd+1; if(&dcd) btn_d<=sd[1];   end
    if(sc_s[1]==btn_c) dcc<=0; else begin dcc<=dcc+1; if(&dcc) btn_c<=sc_s[1]; end
end

// ─── Angle LUT (64 steps, Q2.14) ──────────────────────────────────────────────
reg signed [15:0] angle_table [0:63][0:3];
initial begin
    angle_table[ 0][0]=16'sh4000; angle_table[ 0][1]=16'sh0000; angle_table[ 0][2]=16'sh0000; angle_table[ 0][3]=16'sh2A66;
    angle_table[ 1][0]=16'sh3FF6; angle_table[ 1][1]=16'sh023C; angle_table[ 1][2]=16'shFE84; angle_table[ 1][3]=16'sh2A50;
    angle_table[ 2][0]=16'sh3FD9; angle_table[ 2][1]=16'sh0478; angle_table[ 2][2]=16'shFD09; angle_table[ 2][3]=16'sh2A05;
    angle_table[ 3][0]=16'sh3FA9; angle_table[ 3][1]=16'sh06B3; angle_table[ 3][2]=16'shFB90; angle_table[ 3][3]=16'sh2986;
    angle_table[ 4][0]=16'sh3F67; angle_table[ 4][1]=16'sh08E8; angle_table[ 4][2]=16'shFA1A; angle_table[ 4][3]=16'sh28D3;
    angle_table[ 5][0]=16'sh3F0D; angle_table[ 5][1]=16'sh0B19; angle_table[ 5][2]=16'shF8A6; angle_table[ 5][3]=16'sh27EE;
    angle_table[ 6][0]=16'sh3EA2; angle_table[ 6][1]=16'sh0D44; angle_table[ 6][2]=16'shF736; angle_table[ 6][3]=16'sh26D8;
    angle_table[ 7][0]=16'sh3E26; angle_table[ 7][1]=16'sh0F68; angle_table[ 7][2]=16'shF5CA; angle_table[ 7][3]=16'sh2592;
    angle_table[ 8][0]=16'sh3D9B; angle_table[ 8][1]=16'sh1187; angle_table[ 8][2]=16'shF462; angle_table[ 8][3]=16'sh2424;
    angle_table[ 9][0]=16'sh3CF7; angle_table[ 9][1]=16'sh139F; angle_table[ 9][2]=16'shF2FF; angle_table[ 9][3]=16'sh2290;
    angle_table[10][0]=16'sh3C42; angle_table[10][1]=16'sh15AE; angle_table[10][2]=16'shF1A0; angle_table[10][3]=16'sh20D8;
    angle_table[11][0]=16'sh3B78; angle_table[11][1]=16'sh17B5; angle_table[11][2]=16'shF046; angle_table[11][3]=16'sh1EFD;
