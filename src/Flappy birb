`timescale 1ns / 1ps

module top (
    input  wire        clk,
    input  wire        BTNL,   // flap / jump
    input  wire        BTNR,   // move right
    input  wire        BTNU,   // move left
    input  wire        BTND,   // unused
    output reg         Hsync,
    output reg         Vsync,
    output reg  [3:0]  Red,
    output reg  [3:0]  Green,
    output reg  [3:0]  Blue
);

// ============================================================================
// Reset / clocks
// ============================================================================

// Power-on reset
reg [3:0] rst_sr = 4'b1111;
wire rst = rst_sr[0];
always @(posedge clk)
    rst_sr <= {1'b0, rst_sr[3:1]};

// 25 MHz pixel tick from 100 MHz
reg [1:0] clk_div = 0;
wire pixel_tick = (clk_div == 2'd0);
always @(posedge clk)
    clk_div <= clk_div + 1'b1;

// ============================================================================
// VGA timing 640x480@60
// ============================================================================

reg [9:0] hcnt = 0, vcnt = 0;

always @(posedge clk) begin
    if (pixel_tick) begin
        if (hcnt == 10'd799) begin
            hcnt <= 10'd0;
            vcnt <= (vcnt == 10'd524) ? 10'd0 : (vcnt + 10'd1);
        end else begin
            hcnt <= hcnt + 10'd1;
        end
    end
end

wire hsync_active = (hcnt >= 10'd656) && (hcnt < 10'd752);
wire vsync_active = (vcnt >= 10'd490) && (vcnt < 10'd492);
wire video_on     = (hcnt < 10'd640) && (vcnt < 10'd480);

reg vsync_r = 1'b0;
always @(posedge clk)
    vsync_r <= vsync_active;

always @(posedge clk) begin
    Hsync <= ~hsync_active;
    Vsync <= ~vsync_active;
end

// ============================================================================
// Button sync + debounce
// ============================================================================

reg [1:0] sync_l=0, sync_r=0, sync_u=0, sync_d=0;
always @(posedge clk) begin
    sync_l <= {sync_l[0], BTNL};
    sync_r <= {sync_r[0], BTNR};
    sync_u <= {sync_u[0], BTNU};
    sync_d <= {sync_d[0], BTND};
end

reg [19:0] db_cnt_l=0, db_cnt_r=0, db_cnt_u=0, db_cnt_d=0;
reg btn_l=0, btn_r=0, btn_u=0, btn_d=0;

always @(posedge clk) begin
    if (sync_l[1] == btn_l) db_cnt_l <= 20'd0;
    else begin
        db_cnt_l <= db_cnt_l + 20'd1;
        if (db_cnt_l == 20'hFFFFF) btn_l <= sync_l[1];
    end

    if (sync_r[1] == btn_r) db_cnt_r <= 20'd0;
    else begin
        db_cnt_r <= db_cnt_r + 20'd1;
        if (db_cnt_r == 20'hFFFFF) btn_r <= sync_r[1];
    end

    if (sync_u[1] == btn_u) db_cnt_u <= 20'd0;
    else begin
        db_cnt_u <= db_cnt_u + 20'd1;
        if (db_cnt_u == 20'hFFFFF) btn_u <= sync_u[1];
    end

    if (sync_d[1] == btn_d) db_cnt_d <= 20'd0;
    else begin
        db_cnt_d <= db_cnt_d + 20'd1;
        if (db_cnt_d == 20'hFFFFF) btn_d <= sync_d[1];
    end
end

wire any_btn = btn_l | btn_r | btn_u | btn_d;

// ============================================================================
// One-shot button event latches
// ============================================================================

reg prev_btn_l_d = 0, prev_btn_r_d = 0, prev_btn_u_d = 0;
reg btn_l_event  = 0, btn_r_event  = 0, btn_u_event  = 0;

// ============================================================================
// Splash
// ============================================================================

reg splash_mode = 1'b1;
always @(posedge clk) begin
    if (rst)          splash_mode <= 1'b1;
    else if (any_btn) splash_mode <= 1'b0;
end

localparam IMG_W  = 320;
localparam IMG_H  = 240;
localparam PIXELS = IMG_W * IMG_H;

reg [11:0] frame_rom [0:PIXELS-1];
//initial $readmemh("frame.hex", frame_rom);

wire [9:0] h_early  = hcnt - 10'd1;
wire [8:0] img_x    = h_early[9:1];
wire [7:0] img_y    = vcnt[8:1];
wire       in_image = (img_x < IMG_W) && (img_y < IMG_H);

// img_y * 320 = img_y * (256 + 64)
wire [16:0] rom_addr =
    in_image ? (({9'd0, img_y} << 8) + ({9'd0, img_y} << 6) + {8'd0, img_x}) : 17'd0;

reg [11:0] splash_pixel = 12'h000;
always @(posedge clk)
    splash_pixel <= frame_rom[rom_addr];

// ============================================================================
// Memories / state shared by renderer + CPU
// ============================================================================

// Tile / palette memories
reg [11:0] palette [0:15];
reg [3:0]  tile_gfx [0:511];
reg [4:0]  tilemap  [0:959];
reg [15:0] sprite_table [0:7];
reg [15:0] program_rom [0:255];
reg [15:0] registers [0:15];
reg [7:0]  pc;

// ============================================================================
// Background tile renderer
// ============================================================================

wire [4:0] tile_col = hcnt / 10'd20;
wire [4:0] tile_row = vcnt[8:4];          // /16
wire [1:0] px_in_tile = (hcnt % 10'd20) / 10'd5;
wire [1:0] py_in_tile = vcnt[3:2];

wire [9:0] tm_addr  = {tile_row, 5'b00000} + tile_col;
wire [4:0] bg_tid   = tilemap[tm_addr];
wire [8:0] bg_gaddr = {bg_tid, py_in_tile, px_in_tile};
wire [3:0] bg_pal   = tile_gfx[bg_gaddr];
wire [11:0] bg_colour = palette[bg_pal];

// ============================================================================
// Pixel-positioned bird overlay
// R1 = tile column (20 px steps)
// R2 = quarter-row position (1 unit = 4 px)
// Bird size = 40x32 pixels using tiles 4,5,6,7 directly
// ============================================================================

wire [9:0] bird_x_px = ({5'd0, registers[1][4:0]} << 4) + ({5'd0, registers[1][4:0]} << 2); // *20
wire [9:0] bird_y_px = {registers[2][7:0], 2'b00}; // *4

wire bird_on =
    (hcnt >= bird_x_px) && (hcnt < (bird_x_px + 10'd40)) &&
    (vcnt >= bird_y_px) && (vcnt < (bird_y_px + 10'd32));

wire [5:0] bird_dx = hcnt - bird_x_px;
wire [5:0] bird_dy = vcnt - bird_y_px;

reg [2:0] bird_px_full;
reg [2:0] bird_py_full;
reg [4:0] bird_tid;

always @(*) begin
    if      (bird_dx <  6'd5)  bird_px_full = 3'd0;
    else if (bird_dx <  6'd10) bird_px_full = 3'd1;
    else if (bird_dx <  6'd15) bird_px_full = 3'd2;
    else if (bird_dx <  6'd20) bird_px_full = 3'd3;
    else if (bird_dx <  6'd25) bird_px_full = 3'd4;
    else if (bird_dx <  6'd30) bird_px_full = 3'd5;
    else if (bird_dx <  6'd35) bird_px_full = 3'd6;
    else                       bird_px_full = 3'd7;
end

always @(*) begin
    bird_py_full = bird_dy[4:2]; // /4, 0..7
end

always @(*) begin
    case ({bird_py_full[2], bird_px_full[2]})
        2'b00: bird_tid = 5'd4; // top-left
        2'b01: bird_tid = 5'd5; // top-right
        2'b10: bird_tid = 5'd6; // bottom-left
        default: bird_tid = 5'd7; // bottom-right
    endcase
end

wire [8:0] bird_gaddr = {bird_tid, bird_py_full[1:0], bird_px_full[1:0]};
wire [3:0] bird_pal   = bird_on ? tile_gfx[bird_gaddr] : 4'd0;
wire [11:0] bird_colour = palette[bird_pal];

wire [11:0] game_pixel_colour =
    (bird_on && (bird_pal != 4'h0)) ? bird_colour : bg_colour;

// Output pipeline alignment
reg        video_on_r     = 1'b0;
reg [11:0] game_pixel_r   = 12'h000;
reg        splash_mode_r  = 1'b1;

always @(posedge clk) begin
    video_on_r    <= video_on;
    game_pixel_r  <= game_pixel_colour;
    splash_mode_r <= splash_mode;
end

always @(posedge clk) begin
    if (splash_mode_r) begin
        if (video_on_r) {Red, Green, Blue} <= splash_pixel;
        else            {Red, Green, Blue} <= 12'h000;
    end else begin
        if (video_on_r) {Red, Green, Blue} <= game_pixel_r;
        else            {Red, Green, Blue} <= 12'h000;
    end
end

