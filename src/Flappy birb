// ============================================================================
// Program ROM
// Key change: R2 is now quarter-rows (1 unit = 4 px)
// Start row: 10 tiles -> 40 quarter-rows
// Floor row: 27 tiles -> 108 quarter-rows
// Gravity pulse: every 2 frames instead of every 4
// Bird sprite table builder removed (direct bird renderer now used)
// ============================================================================

integer fi;
initial begin
    for (fi = 0; fi < 256; fi = fi + 1)
        program_rom[fi] = 16'b1111_0000_0000_0000; // HALT by default

    program_rom[  0] = 16'b1100000100001000; // SETX R1,8     bird_col
    program_rom[  1] = 16'b1100001000101000; // SETX R2,40    bird_y_qrow
    program_rom[  2] = 16'b1100011100011111; // SETX R7,31    wrap mask
    program_rom[  3] = 16'b1101110100000001; // ADDI R13,R0,1 const1
    program_rom[  4] = 16'b1101100000000000; // ADDI R8,R0,0  vel=0
    program_rom[  5] = 16'b1100010101101100; // SETX R5,108   floor (27*4)
    program_rom[  6] = 16'b1100111000011100; // SETX R14,28   pipe_col
      program_rom[  7] = 16'b1100111100000000; // SETX R15,0    pipe_ticker = 0

    // VSYNC lock
    program_rom[  8] = 16'b1110110000000000; // IN R12,vsync
    program_rom[  9] = 16'b1011101110110000; // NOP
    program_rom[ 10] = 16'b1010000011001101; // BLT R12,R13 -> 8
    program_rom[ 11] = 16'b1110110000000000; // IN R12,vsync
    program_rom[ 12] = 16'b1011101110110000; // NOP
    program_rom[ 13] = 16'b1011101110110000; // NOP
    program_rom[ 14] = 16'b1010000000001100; // BLT R0,R12 -> 11

    // Button reads
    program_rom[ 15] = 16'b1011101110110000; // NOP
    program_rom[ 16] = 16'b1110010000100000; // IN R4,btn_l_event (flap)
    program_rom[ 17] = 16'b1011101110110000; // NOP
    program_rom[ 18] = 16'b1011101110110000; // NOP
    program_rom[ 19] = 16'b1011101110110000; // NOP
    program_rom[ 20] = 16'b0100001100110100; // OR R3,R3,R4
    program_rom[ 21] = 16'b1110010001000000; // IN R4,btn_u_event (move left)

    // Physics: mod-2 gravity pulse
    program_rom[ 22] = 16'b0001101010101101; // ADD R10,R10,R13
    program_rom[ 23] = 16'b0111100110100001; // SHR R9,R10,1
    program_rom[ 24] = 16'b0110110010010001; // SHL R12,R9,1
    program_rom[ 25] = 16'b0010101010101100; // SUB R10,R10,R12
    program_rom[ 26] = 16'b0001100010001001; // ADD R8,R8,R9
       // [27] R11 = R3 & R9  (jump fires this frame only on pulse)
    program_rom[ 27] = 16'b0011101100111001; // AND R11, R3, R9

    // [28] Clear latch ONLY when jump fires (R3 &= ~R11, not ~R9)
    program_rom[ 28] = 16'b0101110010110000; // NOT R12, R11
    program_rom[ 29] = 16'b0011001100111100; // AND R3, R3, R12   ← clear only on actual jump

    // [30] Gravity cancel on jump frame (same as before)
    program_rom[ 30] = 16'b0011110010111001; // AND R12, R11, R9

    // [31] vel -= 1 (cancel gravity)
    program_rom[ 31] = 16'b0010100010001100; // SUB R8, R8, R12

    // [32] vel -= 4 (jump impulse, doubled)
    program_rom[ 32] = 16'b0110110010110010; // SHL R12, R11, 2

    // [33] apply impulse
    program_rom[ 33] = 16'b0010100010001100; // SUB R8, R8, R12
    // Movement
    program_rom[ 34] = 16'b1110110000010000; // IN R12,btn_r_event
    program_rom[ 35] = 16'b0001000100011100; // ADD R1,R1,R12
    program_rom[ 36] = 16'b0010000100010100; // SUB R1,R1,R4
    program_rom[ 37] = 16'b0011000100010111; // AND R1,R1,R7
    program_rom[ 38] = 16'b0001001000101000; // ADD R2,R2,R8

    // Boundary clamps
    program_rom[ 39] = 16'b1010000000000010; // BLT R0,R2 -> 42
    program_rom[ 40] = 16'b1100001000000000; // SETX R2,0
    program_rom[ 41] = 16'b1101100000000000; // ADDI R8,R0,0
    program_rom[ 42] = 16'b1010000000100101; // BLT R2,R5 -> 45
    program_rom[ 43] = 16'b1100001001101100; // SETX R2,108
    program_rom[ 44] = 16'b1101100000000000; // ADDI R8,R0,0
    program_rom[ 45] = 16'b1011101110110000; // NOP
    program_rom[ 46] = 16'b1011101110110000; // NOP
    program_rom[ 47] = 16'b1011101110110000; // NOP

    // Pipe section (unchanged)
    program_rom[ 48] = 16'b1101011011100001;
    program_rom[ 49] = 16'b1100100100011110;
    program_rom[ 50] = 16'b1101101100000000;
    program_rom[ 51] = 16'b0110110010110101;
    program_rom[ 52] = 16'b0001110011001110;
    program_rom[ 53] = 16'b0000000111001101;
    program_rom[ 54] = 16'b1101101110110001;
    program_rom[ 55] = 16'b1011101110110000;
    program_rom[ 56] = 16'b1011101110110000;
    program_rom[ 57] = 16'b1010000010111001;
    program_rom[ 58] = 16'b0001101111011101;
    program_rom[ 59] = 16'b0110110011110101;
    program_rom[ 60] = 16'b0001110011001110;
    program_rom[ 61] = 16'b0000000111001011;
    program_rom[ 62] = 16'b1100100100011110;
    program_rom[ 63] = 16'b1101101100000000;
    program_rom[ 64] = 16'b0110110010110101;
    program_rom[ 65] = 16'b0001110011000110;
    program_rom[ 66] = 16'b0000000111001101;
    program_rom[ 67] = 16'b1101101110110001;
    program_rom[ 68] = 16'b1011101110110000;
    program_rom[ 69] = 16'b1011101110110000;
    program_rom[ 70] = 16'b1010000010111001;
    program_rom[ 71] = 16'b0001101111011101;
    program_rom[ 72] = 16'b0110110011110101;
    program_rom[ 73] = 16'b0001110011000110;
    program_rom[ 74] = 16'b0000000111001011;
    program_rom[ 75] = 16'b1101011011100010;
    program_rom[ 76] = 16'b0011011001100111;
    program_rom[ 77] = 16'b1100100100011110;
    program_rom[ 78] = 16'b1101101100000000;
    program_rom[ 79] = 16'b0110110010110101;
    program_rom[ 80] = 16'b0001110011000110;
    program_rom[ 81] = 16'b0000000111000000;
    program_rom[ 82] = 16'b1101101110110001;
    program_rom[ 83] = 16'b1011101110110000;
    program_rom[ 84] = 16'b1011101110110000;
    program_rom[ 85] = 16'b1010000010111001;
    program_rom[ 86] = 16'b1101011011100011;
    program_rom[ 87] = 16'b0011011001100111;
    program_rom[ 88] = 16'b1100100100011110;
    program_rom[ 89] = 16'b1101101100000000;
    program_rom[ 90] = 16'b0110110010110101;
    program_rom[ 91] = 16'b0001110011000110;
    program_rom[ 92] = 16'b0000000111000000;
    program_rom[ 93] = 16'b1101101110110001;
    program_rom[ 94] = 16'b1011101110110000;
    program_rom[ 95] = 16'b1011101110110000;
    program_rom[ 96] = 16'b1010000010111001;

    // Pipe scroll for mod-2 timer
       // Pipe scroll - use R6 as scratch, DO NOT clobber R9
       // Pipe scroll - dedicated mod-4 counter in R15 (pipe_row no longer needed)
    program_rom[ 97] = 16'b0001111111111101; // ADD R15,R15,R13  pipe_ticker++
    program_rom[ 98] = 16'b0111011011110010; // SHR R6, R15,2    R6=1 when ticker>=4
    program_rom[ 99] = 16'b0011110001101101; // AND R12,R6, R13  R12 = pulse flag
    program_rom[100] = 16'b0110101111000010; // SHL R11,R12,2    R11 = 4 if pulse
    program_rom[101] = 16'b0010111111111011; // SUB R15,R15,R11  R15 mod 4 reset
    program_rom[102] = 16'b0010111011101100; // SUB R14,R14,R12  pipe_col--
    program_rom[103] = 16'b0011111011100111; // AND R14,R14,R7   pipe_col wrap 31→0
    // Bird sprite-table builder removed; direct pixel bird renderer is used
    program_rom[104] = 16'b1011101110110000;
    program_rom[105] = 16'b1011101110110000;
    program_rom[106] = 16'b1011101110110000;
    program_rom[107] = 16'b1011101110110000;
    program_rom[108] = 16'b1011101110110000;
    program_rom[109] = 16'b1011101110110000;
    program_rom[110] = 16'b1011101110110000;
    program_rom[111] = 16'b1011101110110000;
    program_rom[112] = 16'b1011101110110000;
    program_rom[113] = 16'b1011101110110000;
    program_rom[114] = 16'b1011101110110000;
    program_rom[115] = 16'b1011101110110000;
    program_rom[116] = 16'b1011101110110000;
    program_rom[117] = 16'b1011101110110000;
    program_rom[118] = 16'b1011101110110000;
    program_rom[119] = 16'b1011101110110000;
    program_rom[120] = 16'b1011101110110000;
    program_rom[121] = 16'b1011101110110000;
    program_rom[122] = 16'b1011101110110000;
    program_rom[123] = 16'b1011101110110000;
    program_rom[124] = 16'b1011101110110000;
    program_rom[125] = 16'b1011101110110000;
    program_rom[126] = 16'b1011101110110000;
    program_rom[127] = 16'b1011101110110000;
    program_rom[128] = 16'b1011101110110000;
    program_rom[129] = 16'b1011101110110000;
    program_rom[130] = 16'b1011101110110000;
    program_rom[131] = 16'b1011101110110000;
    program_rom[132] = 16'b1011101110110000;
    program_rom[133] = 16'b1011101110110000;
    program_rom[134] = 16'b1011101110110000;
    program_rom[135] = 16'b1011101110110000;
    program_rom[136] = 16'b1011101110110000;
    program_rom[137] = 16'b1011101110110000;

    program_rom[138] = 16'b1000000000001000; // JMP 8
end

// ============================================================================
// Register / PC init
// ============================================================================

integer ri;
initial begin
    pc = 8'd0;
    for (ri = 0; ri < 16; ri = ri + 1)
        registers[ri] = 16'd0;
end

// ============================================================================
// CPU decode
// ============================================================================

wire [15:0] instr_w    = program_rom[pc];
wire [3:0]  opcode     = instr_w[15:12];
wire [3:0]  rd         = instr_w[11:8];
wire [3:0]  rs1        = instr_w[7:4];
wire [3:0]  rs2_or_imm = instr_w[3:0];
wire [7:0]  imm8       = instr_w[7:0];
wire [11:0] addr12     = instr_w[11:0];

wire signed [7:0]  br_offs   = {{4{rs2_or_imm[3]}}, rs2_or_imm};
wire signed [15:0] s_rs1_val = registers[rs1];

// CPU tick = 25 MHz / 4 = 6.25 MHz instruction rate
reg [1:0] cpu_cnt = 0;
wire cpu_tick = (cpu_cnt == 2'd3);

always @(posedge clk)
    cpu_cnt <= (rst || cpu_tick) ? 2'd0 : (cpu_cnt + 2'd1);

// ============================================================================
// One-shot button event management
// ============================================================================

always @(posedge clk) begin
    prev_btn_l_d <= btn_l;
    prev_btn_r_d <= btn_r;
    prev_btn_u_d <= btn_u;

    if (btn_l & ~prev_btn_l_d) btn_l_event <= 1'b1;
    if (btn_r & ~prev_btn_r_d) btn_r_event <= 1'b1;
    if (btn_u & ~prev_btn_u_d) btn_u_event <= 1'b1;

    if (rst) begin
        btn_l_event <= 1'b0;
        btn_r_event <= 1'b0;
        btn_u_event <= 1'b0;
    end else if (cpu_tick && !splash_mode && opcode == 4'b1110) begin
        if (rs1 == 4'b0010) btn_l_event <= 1'b0; // IN rd, btn_l
        if (rs1 == 4'b0001) btn_r_event <= 1'b0; // IN rd, btn_r
        if (rs1 == 4'b0100) btn_u_event <= 1'b0; // IN rd, btn_u
    end
end

// ============================================================================
// CPU execute
// ============================================================================

always @(posedge clk) begin
    if (rst) begin
        pc <= 8'd0;
        for (ri = 0; ri < 16; ri = ri + 1)
            registers[ri] <= 16'd0;
    end else if (cpu_tick && !splash_mode) begin
        case (opcode)
            4'b0000: begin
                case (rd)
                    4'b0001: if (registers[rs1] < 16'd960)
                                tilemap[registers[rs1][9:0]] <= registers[rs2_or_imm][4:0];
                    4'b0010: if (registers[rs1] < 16'd8)
                                sprite_table[registers[rs1][2:0]] <= registers[rs2_or_imm];
                    4'b0011: if (registers[rs1] < 16'd512)
                                tile_gfx[registers[rs1][8:0]] <= registers[rs2_or_imm][3:0];
                    4'b0100: if (registers[rs1] < 16'd16)
                                palette[registers[rs1][3:0]] <= registers[rs2_or_imm][11:0];
                    default: ;
                endcase
                pc <= pc + 8'd1;
            end

            4'b0001: begin
                registers[rd] <= registers[rs1] + registers[rs2_or_imm];
                pc <= pc + 8'd1;
            end

            4'b0010: begin
                registers[rd] <= registers[rs1] - registers[rs2_or_imm];
                pc <= pc + 8'd1;
            end

            4'b0011: begin
                registers[rd] <= registers[rs1] & registers[rs2_or_imm];
                pc <= pc + 8'd1;
            end

            4'b0100: begin
                registers[rd] <= registers[rs1] | registers[rs2_or_imm];
                pc <= pc + 8'd1;
            end

            4'b0101: begin
                registers[rd] <= ~registers[rs1];
                pc <= pc + 8'd1;
            end

            4'b0110: begin
                registers[rd] <= registers[rs1] << rs2_or_imm;
                pc <= pc + 8'd1;
            end

            4'b0111: begin
                registers[rd] <= registers[rs1] >> rs2_or_imm;
                pc <= pc + 8'd1;
            end

            4'b1000: begin
                pc <= addr12[7:0];
            end

            4'b1001: begin
                if (registers[rd] == registers[rs2_or_imm]) pc <= pc + 8'd1 + br_offs;
                else                                        pc <= pc + 8'd1;
            end

            4'b1010: begin
                if (s_rs1_val < $signed(registers[rs2_or_imm])) pc <= pc + 8'd1 + br_offs;
                else                                            pc <= pc + 8'd1;
            end

            4'b1011: begin
                pc <= pc + 8'd1;
            end

            4'b1100: begin
                registers[rd] <= {8'h00, imm8};
                pc <= pc + 8'd1;
            end

            4'b1101: begin
                registers[rd] <= registers[rs1] + {{12{rs2_or_imm[3]}}, rs2_or_imm};
                pc <= pc + 8'd1;
            end

            4'b1110: begin
                case (rs1)
                    4'b0001: registers[rd] <= {15'b0, btn_r_event};
                    4'b0010: registers[rd] <= {15'b0, btn_l_event};
                    4'b0011: registers[rd] <= {15'b0, btn_d};
                    4'b0100: registers[rd] <= {15'b0, btn_u_event};
                    default: registers[rd] <= {15'b0, vsync_r};
                endcase
                pc <= pc + 8'd1;
            end

            4'b1111: begin
                pc <= pc;
            end

            default: begin
                pc <= pc + 8'd1;
            end
        endcase
if ($signed(registers[8]) < -4)
            registers[8] <= 16'hFFFC;
        // R0 hard-wired to zero
        registers[0] <= 16'd0;
    end
end

endmodule
